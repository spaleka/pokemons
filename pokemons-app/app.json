{
  "expo": {
    "name": "pokemons-app",
    "slug": "pokemons-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pokemonsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "imageWidth": 200,
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pokemonsapp",
      "config": {
        "googleMapsApiKey": "AIzaSyAIXgl0smEJdd4TX0hs_UezB3m4G4LPgwo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.pokemonsapp",
      "minSdkVersion": 26,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "permissions": [
         "android.permission.CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAIXgl0smEJdd4TX0hs_UezB3m4G4LPgwo"
        }
      }
    },
    "plugins": [
      "expo-maps",
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "pokemonsapp needs access to your Camera."
        }
      ],
      [
      "expo-build-properties",
      {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8761943f-da72-4f0f-b500-eb8ad8202595"
      }
    }
  }
}
